[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = KrunEfiVarsPei
  FILE_GUID                      = 77607846-5B25-4D76-91C0-0BD92071D168
  MODULE_TYPE                    = PEIM
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = KrunEfiVarsPeiEntryPoint

[Sources]
  KrunEfiVarsPei.c

[Packages]
  ArmPkg/ArmPkg.dec
  ArmVirtPkg/ArmVirtPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec

[LibraryClasses]
  ArmMmuLib
  BaseLib
  DebugLib
  FdtLib
  HobLib
  PcdLib
  PeimEntryPoint

[Pcd]
  gArmVirtTokenSpaceGuid.PcdDeviceTreeInitialBaseAddress
  gEfiMdeModulePkgTokenSpaceGuid.PcdEmuVariableNvStoreReserved   ## SOMETIMES_PRODUCES
  gEfiMdeModulePkgTokenSpaceGuid.PcdVariableStoreSize            ## CONSUMES

[Depex]
  gEfiPeiMemoryDiscoveredPpiGuid AND gPcdPpiGuid
